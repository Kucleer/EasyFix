# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=easyfix

# OpenAI API
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Server
HOST=0.0.0.0
PORT=8000

# PDF: 默认先运行 python -m playwright install chromium
# 本机已有 Edge 时可设置 msedge；部署环境也可设 chrome
PDF_BROWSER_CHANNEL=
PDF_TIMEOUT_MS=30000
# Linux 等无中文字体的环境请设置字体绝对路径
PDF_FONT_PATH=
